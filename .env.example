# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_CRM_MODEL=gpt-5.6-terra
# Use a private random value to pseudonymize safety identifiers.
OPENAI_SAFETY_SALT=

# Provider-agnostic operations controls
OPERATIONS_HASH_SALT=
READINESS_DATABASE_TIMEOUT_MS=3000
AI_OPERATIONS_ENABLED=true
AI_PROVIDER_TIMEOUT_MS=15000
AI_PROVIDER_MAX_RETRIES=1
PUBLIC_CHAT_RATE_LIMIT=20
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_REQUEST_LIMIT=50
AI_DAILY_TOKEN_LIMIT=100000
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_WINDOW_MINUTES=5

# Preview Playwright E2E requires PLAYWRIGHT_BASE_URL, SUPABASE_DB_URL,
# E2E_ADMIN_EMAIL, CLERK_PUBLISHABLE_KEY, CLERK_SECRET_KEY, and
# VERCEL_AUTOMATION_BYPASS_SECRET. Use an isolated non-production environment
# and dedicated test identities.
PLAYWRIGHT_BASE_URL=
PLAYWRIGHT_PORT=3100
VERCEL_AUTOMATION_BYPASS_SECRET=
E2E_ADMIN_EMAIL=
E2E_ADVISOR_PROFILE_ID=
E2E_STUDENT_PROFILE_ID=
E2E_SECOND_ADVISOR_PROFILE_ID=
E2E_APPLICATION_STUDENT_PROFILE_ID=
E2E_APPLICATION_INTAKE_ID=
E2E_RUN_ID=
SUPABASE_DB_URL=
