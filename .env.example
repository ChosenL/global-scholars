# Provider-agnostic operations controls
OPERATIONS_HASH_SALT=
READINESS_DATABASE_TIMEOUT_MS=3000
AI_OPERATIONS_ENABLED=true
AI_PROVIDER_TIMEOUT_MS=15000
AI_PROVIDER_MAX_RETRIES=1
PUBLIC_CHAT_RATE_LIMIT=20
AI_RATE_LIMIT_PER_MINUTE=10
AI_DAILY_REQUEST_LIMIT=50
AI_DAILY_TOKEN_LIMIT=100000
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_WINDOW_MINUTES=5

# Playwright Organization Management workflow
# Use an isolated non-production environment and dedicated test identities.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_ADVISOR_PROFILE_ID=
E2E_STUDENT_PROFILE_ID=
