{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-config.schema.json",
  "title": "University data source configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceName",
    "jurisdiction",
    "sourceUrl",
    "releaseVersion",
    "retrievalMethod",
    "licensingTermsNote",
    "adapterName",
    "enabled",
    "checksumRequired"
  ],
  "properties": {
    "sourceName": { "type": "string", "minLength": 2 },
    "jurisdiction": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "sourceUrl": { "type": "string", "pattern": "^https://" },
    "releaseVersion": { "type": "string", "minLength": 1 },
    "retrievalMethod": { "enum": ["download", "api", "html", "manual"] },
    "licensingTermsNote": { "type": "string", "minLength": 10 },
    "adapterName": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
    "enabled": { "type": "boolean" },
    "checksumRequired": { "const": true },
    "pilotLimit": { "type": "integer", "minimum": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url", "fileName", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://" },
          "fileName": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\.zip$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
