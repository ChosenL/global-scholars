{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSystem",
        "sourceEntityId",
        "sourceUrl",
        "sourceVersion",
        "retrievedAt",
        "rawChecksum",
        "mappingVersion"
      ],
      "properties": {
        "sourceSystem": { "type": "string", "minLength": 2 },
        "sourceEntityId": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "sourceVersion": { "type": "string", "minLength": 1 },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "rawChecksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "mappingVersion": { "type": "string", "minLength": 1 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalId", "recordHash", "provenance"],
      "properties": {
        "canonicalId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "recordHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
