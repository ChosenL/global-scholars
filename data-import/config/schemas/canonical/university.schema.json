{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "university.schema.json",
  "title": "Canonical university",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entityType",
    "canonicalId",
    "recordHash",
    "provenance",
    "countryCanonicalId",
    "name",
    "slug",
    "catalogClassification",
    "degreeGranting",
    "acceptsDirectApplications",
    "searchEligible",
    "classificationRule",
    "classificationEvidence",
    "searchEligibilityEvidence",
    "isActive"
  ],
  "properties": {
    "entityType": { "const": "university" },
    "canonicalId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recordHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "countryCanonicalId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 200 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "institutionType": { "type": ["string", "null"], "maxLength": 100 },
    "websiteUrl": { "type": ["string", "null"] },
    "catalogClassification": {
      "enum": [
        "degree_granting_institution",
        "system_or_administrative_office",
        "branch_or_campus",
        "non_degree_or_specialized_entity",
        "classification_unknown"
      ]
    },
    "degreeGranting": { "type": ["boolean", "null"] },
    "acceptsDirectApplications": { "type": ["boolean", "null"] },
    "searchEligible": { "type": "boolean" },
    "classificationRule": { "type": "string", "minLength": 3 },
    "classificationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "ruleVersion", "sourceFields"],
      "properties": {
        "source": { "type": "string", "minLength": 3 },
        "ruleVersion": { "type": "string", "minLength": 1 },
        "sourceFields": { "type": "object" }
      }
    },
    "searchEligibilityEvidence": {
      "enum": [
        "confirmed",
        "inferred_from_authoritative_structure",
        "confirmed_ineligible",
        "unknown"
      ]
    },
    "internationalStudentStatus": {
      "enum": ["designated", "not_designated", "unknown"]
    },
    "dliNumber": { "type": ["string", "null"], "pattern": "^O[0-9]+$" },
    "degreeLevels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "certificate",
          "diploma",
          "associate",
          "bachelor",
          "postgraduate_certificate",
          "master",
          "doctorate",
          "other"
        ]
      }
    },
    "isActive": { "type": "boolean" }
  }
}
