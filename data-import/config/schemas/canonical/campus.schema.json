{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "campus.schema.json",
  "title": "Canonical campus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entityType",
    "canonicalId",
    "recordHash",
    "provenance",
    "universityCanonicalId",
    "name",
    "city",
    "isPrimary",
    "isActive"
  ],
  "properties": {
    "entityType": { "const": "campus" },
    "canonicalId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "recordHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "universityCanonicalId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 150 },
    "city": { "type": "string", "minLength": 2, "maxLength": 150 },
    "region": { "type": ["string", "null"], "maxLength": 150 },
    "isPrimary": { "type": "boolean" },
    "isActive": { "type": "boolean" }
  }
}
